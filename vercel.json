{
  "regions": ["pdx1"],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{lib,migrations,public}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway?__api_path=:path*" },
    { "source": "/admin", "destination": "/" },
    { "source": "/r/:code", "destination": "/" }
  ]
}
